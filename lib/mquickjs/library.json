{
  "name": "MicroQuickJS",
  "description": "MicroQuickJS (aka. MQuickJS) is a JavaScript engine targeted at embedded systems",
  "keywords": "JavaScript",
  "authors": [
    {
      "name": "Fabrice Bellard",
      "url": "https://bellard.org/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bellard/mquickjs"
  },
  "version": "2025-12-22",
  "framework": "*",
  "platforms": "*",
  "build": {
    "srcDir": "mquickjs",
    "includeDir": "include",
    "srcFilter": [
      "-<*>",
      "+<dtoa.c>",
      "+<libm.c>",
      "+<cutils.c>",
      "+<mquickjs.c>",
      "+<mquickjs_build.c>"
    ]
  }
}
