{
  "name": "LibDriver OV2640",
  "description": "The OV2640 CAMERACHIP™ image sensor is a low voltage CMOS device that provides the full functionality of a single-chip UXGA (1632x1232) camera and image processor in a small footprint package",
  "keywords": "OV2640",
  "authors": [
    {
      "name": "LibDriver",
      "url": "https://github.com/libdriver"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/libdriver/ov2640"
  },
  "version": "1.0.9",
  "framework": "*",
  "platforms": "*",
  "build": {
    "srcDir": "ov2640",
    "includeDir": "ov2640",
    "flags": [
      "-Iov2640/src",
      "-Iov2640/interface"
    ],
    "srcFilter": [
      "-<*>",
      "+<src/driver_ov2640.c>",
      "+<src/driver_ov2640.h>",
      "+<interface/driver_ov2640_interface.h>"
    ]
  }
}
