{
  "name": "BlackMagic Debug",
  "description": "The Black Magic Debug suite is a self-contained debugger for microcontrollers which needs no config files and auto-detects plus configures the connected targets",
  "keywords": "blackmagic",
  "authors": [
    {
      "name": "Black Magic Debug",
      "url": "https://black-magic.org/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/blackmagic-debug/blackmagic"
  },
  "version": "2.1.0",
  "framework": "*",
  "platforms": "*",
  "build": {
    "srcDir": "src",
    "includeDir": "include",
    "flags": [
      "-DCONFIG_BMDA=0",
      "-DNO_LIBOPENCM3",
      "-DENABLE_DEBUG=1",
      "-DPLATFORM_PRINTF=platform_printf",
      "-Iblackmagic/src/include",
      "-Iblackmagic/src/target"
    ],
    "srcFilter": [
      "-<*>",
      "+<*.c>",
      "+<../blackmagic/src/*.c>",
      "-<../blackmagic/src/main.c>",
      "-<../blackmagic/src/timing.c>",
      "+<../blackmagic/src/target/*.c>",
      "-<../blackmagic/src/target/swdptap_generic.c>",
      "-<../blackmagic/src/platforms/common/jtagtap.c>",
      "+<../blackmagic/src/platforms/common/swdptap.c>"
    ]
  }
}
